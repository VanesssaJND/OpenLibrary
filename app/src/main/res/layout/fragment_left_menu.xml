<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OpenBook"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPerfil"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="start|center_vertical"
        android:text="Perfil"
        android:textColor="@color/menu_option_text_color"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        app:backgroundTint="@color/menu_option_bg_color"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="end"
        app:iconTint="@color/menu_option_icon_tint"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFotos"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="start|center_vertical"
        android:text="Fotos (Libros)"
        android:textColor="@color/menu_option_text_color"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        app:backgroundTint="@color/menu_option_bg_color"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="end"
        app:iconTint="@color/menu_option_icon_tint"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVideo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="start|center_vertical"
        android:text="Video"
        android:textColor="@color/menu_option_text_color"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        app:backgroundTint="@color/menu_option_bg_color"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="end"
        app:iconTint="@color/menu_option_icon_tint"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWeb"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="start|center_vertical"
        android:text="Web"
        android:textColor="@color/menu_option_text_color"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"
        app:backgroundTint="@color/menu_option_bg_color"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="end"
        app:iconTint="@color/menu_option_icon_tint"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBotones"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="start|center_vertical"
        android:text="Botones"
        android:textColor="@color/menu_option_text_color"
        android:textSize="16sp"
        app:backgroundTint="@color/menu_option_bg_color"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="end"
        app:iconTint="@color/menu_option_icon_tint"
        app:cornerRadius="12dp" />

</LinearLayout>